        "PartialDataCloseAfter": "LastActivity",
        "PreviousButton": "Back",
        "NextButton": "Submit",
        "SurveyTitle": "Saving task data",
        "CollectGeoLocation": "false",
        "AnonymizeResponse": "Yes",
